# Copy this file to ".env" and fill in your local MySQL credentials.
# The .env file is git-ignored and read by the EF Core design-time factory (migrations)
# and by StockFront.App at runtime.
STOCKFRONT_DB_CONNECTION=server=localhost;port=3306;database=stockfront;user=root;password=YOUR_PASSWORD

# Migrations and demo data are applied via explicit terminal commands, not on startup:
#   dotnet run --project stockfront.csproj -- --migrate     # create/update tables
#   dotnet run --project stockfront.csproj -- --seed-admin  # default admin on an empty DB
#   dotnet run --project stockfront.csproj -- --seed        # illustrative demo data