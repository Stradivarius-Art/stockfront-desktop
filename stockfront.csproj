<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <RootNamespace>stockfront</RootNamespace>
  </PropertyGroup>

  <!-- The sibling projects live in subfolders; keep their sources out of the WPF app's glob
       (we reference them as projects instead). -->
  <ItemGroup>
    <Compile Remove="StockFront.Data/**/*.cs;StockFront.Contracts/**/*.cs;StockFront.Auth/**/*.cs;StockFront.Warehouse/**/*.cs" />
    <None Remove="StockFront.Data/**;StockFront.Contracts/**;StockFront.Auth/**;StockFront.Warehouse/**" />
    <EmbeddedResource Remove="StockFront.Data/**;StockFront.Contracts/**;StockFront.Auth/**;StockFront.Warehouse/**" />
    <Page Remove="StockFront.Data/**;StockFront.Contracts/**;StockFront.Auth/**;StockFront.Warehouse/**" />
    <Resource Remove="StockFront.Data/**;StockFront.Contracts/**;StockFront.Auth/**;StockFront.Warehouse/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="5.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="StockFront.Contracts/StockFront.Contracts.csproj" />
    <ProjectReference Include="StockFront.Auth/StockFront.Auth.csproj" />
    <ProjectReference Include="StockFront.Data/StockFront.Data.csproj" />
    <ProjectReference Include="StockFront.Warehouse/StockFront.Warehouse.csproj" />
  </ItemGroup>

</Project>
