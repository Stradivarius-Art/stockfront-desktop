<Window x:Class="stockfront.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:stockfront.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="StockFront — Складской учёт"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WorkAreaBrush}"
        FontFamily="Segoe UI">

    <!-- Top bar with the signed-in user; the dashboard content comes later. -->
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}" Height="64">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" Width="36" Height="36" CornerRadius="9">
                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="StockFront" FontSize="18" FontWeight="Bold" Margin="12,0,0,0"
                               VerticalAlignment="Center" Foreground="{StaticResource HeadingBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                   HorizontalAlignment="Right" Foreground="{StaticResource HeadingBrush}" />
                        <TextBlock Text="{Binding RoleText}" FontSize="12"
                                   HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Border Background="{StaticResource AccentBrush}" Width="40" Height="40" CornerRadius="20">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Content="Выйти" Command="{Binding LogoutCommand}"
                            Margin="16,0,0,0" Padding="14,8" Cursor="Hand"
                            Foreground="{StaticResource AccentBrush}" Background="Transparent"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Вы вошли в систему" FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center" Foreground="{StaticResource HeadingBrush}" />
                <TextBlock Text="Здесь появится складской дашборд."
                           FontSize="14" Margin="0,8,0,0"
                           HorizontalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>