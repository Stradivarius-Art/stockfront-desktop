<Window x:Class="stockfront.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:stockfront.ViewModels"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="StockFront — Складской учёт"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WorkAreaBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Sidebar navigation item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="12,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="12" Padding="16,11" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F7F4EF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ActiveNavBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}">
            <Grid Margin="20,0">
                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Background="{StaticResource AccentBrush}" Width="36" Height="36" CornerRadius="9">
                        <iconPacks:PackIconMaterial Kind="PackageVariantClosed" Foreground="White"
                                                    Width="18" Height="18"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="StockFront" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource HeadingBrush}" />
                        <TextBlock Text="складской учёт" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: search stub + user -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource WorkAreaBrush}" CornerRadius="18" Width="220" Height="36"
                            Margin="0,0,16,0" ToolTip="В разработке">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0">
                            <iconPacks:PackIconMaterial Kind="Magnify" Width="15" Height="15"
                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                        VerticalAlignment="Center" />
                            <TextBlock Text="поиск товара" Foreground="{StaticResource SecondaryTextBrush}"
                                       FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>

                    <iconPacks:PackIconMaterial Kind="BellOutline" Width="20" Height="20"
                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                VerticalAlignment="Center" Margin="0,0,16,0"
                                                ToolTip="В разработке" />

                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                   HorizontalAlignment="Right" Foreground="{StaticResource HeadingBrush}" />
                        <TextBlock Text="{Binding RoleText}" FontSize="12"
                                   HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="profile"
                            Cursor="Hand" ToolTip="Профиль" BorderThickness="0" Background="Transparent" Padding="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource AccentBrush}" Width="40" Height="40" CornerRadius="20">
                                    <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button Content="Выйти" Command="{Binding LogoutCommand}"
                            Margin="16,0,0,0" Cursor="Hand" FontSize="14"
                            Foreground="{StaticResource AccentBrush}" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" CornerRadius="10" Padding="16,8" Background="Transparent"
                                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource ActiveNavBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: sidebar + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}">
                <StackPanel Margin="0,16">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Visibility="{Binding ShowDashboard, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=dashboard, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="dashboard">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ViewDashboardOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Дашборд" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Visibility="{Binding ShowWarehouse, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=warehouse, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="warehouse">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Warehouse" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Склад" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Visibility="{Binding ShowStorefront, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=storefront, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="storefront">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="StorefrontOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Витрина" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Visibility="{Binding ShowOrders, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=orders, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="orders">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ClipboardListOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Заказы" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Visibility="{Binding ShowReports, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=reports, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="reports">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChartBar" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Отчёты" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav"
                                 Visibility="{Binding ShowUsers, Converter={StaticResource BoolToVisibilityConverter}}"
                                 IsChecked="{Binding CurrentSection, Converter={StaticResource StringEqualsConverter}, ConverterParameter=users, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="users">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="AccountGroupOutline" Width="18" Height="18" VerticalAlignment="Center" />
                            <TextBlock Text="Пользователи" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
