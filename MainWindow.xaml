<Window x:Class="stockfront.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:stockfront.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="StockFront — Складской учёт"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WorkAreaBrush}"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Sidebar navigation item -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="12,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="12" Padding="16,11" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#F7F4EF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ActiveNavBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}">
            <Grid Margin="20,0">
                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Border Background="{StaticResource AccentBrush}" Width="36" Height="36" CornerRadius="9">
                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="StockFront" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource HeadingBrush}" />
                        <TextBlock Text="складской учёт" FontSize="11"
                                   Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: search stub + user -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource WorkAreaBrush}" CornerRadius="18" Width="220" Height="36"
                            Margin="0,0,16,0" ToolTip="В разработке">
                        <TextBlock Text="🔍  поиск товара" Foreground="{StaticResource SecondaryTextBrush}"
                                   FontSize="13" VerticalAlignment="Center" Margin="14,0" />
                    </Border>

                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"
                                   HorizontalAlignment="Right" Foreground="{StaticResource HeadingBrush}" />
                        <TextBlock Text="{Binding RoleText}" FontSize="12"
                                   HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <Border Background="{StaticResource AccentBrush}" Width="40" Height="40" CornerRadius="20">
                        <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Button Content="Выйти" Command="{Binding LogoutCommand}"
                            Margin="16,0,0,0" Padding="14,8" Cursor="Hand"
                            Foreground="{StaticResource AccentBrush}" Background="Transparent"
                            BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: sidebar + content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource CardBrush}">
                <StackPanel Margin="0,16">
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Дашборд" IsChecked="True"
                                 Command="{Binding NavigateCommand}" CommandParameter="dashboard" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Склад"
                                 Command="{Binding NavigateCommand}" CommandParameter="warehouse" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Витрина"
                                 Command="{Binding NavigateCommand}" CommandParameter="storefront" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Заказы"
                                 Command="{Binding NavigateCommand}" CommandParameter="orders" />
                    <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Отчёты"
                                 Command="{Binding NavigateCommand}" CommandParameter="reports" />
                </StackPanel>
            </Border>

            <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</Window>
