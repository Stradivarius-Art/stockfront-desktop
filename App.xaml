<Application x:Class="stockfront.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:stockfront"
             xmlns:conv="clr-namespace:stockfront.Converters"
             xmlns:sys="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
             xmlns:vm="clr-namespace:stockfront.ViewModels"
             xmlns:views="clr-namespace:stockfront.Views">
    <Application.Resources>
        <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter" />
        <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
        <conv:MoneyToRubleConverter x:Key="MoneyToRubleConverter" />
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <conv:EqualityConverter x:Key="EqualityConverter" />
        <conv:StockStatusConverter x:Key="StockStatusConverter" />
        <conv:OrderStatusConverter x:Key="OrderStatusConverter" />
        <conv:StorefrontAvailabilityConverter x:Key="StorefrontAvailabilityConverter" />
        <conv:DaysOfSupplyTooltipConverter x:Key="DaysOfSupplyTooltipConverter" />
        <conv:ImageSourceConverter x:Key="ImageSourceConverter" />
        <conv:ZeroToVisibleConverter x:Key="ZeroToVisibleConverter" />
        <!-- true → Visible, false → Collapsed. Used to gate sidebar items by the current user's role. -->
        <sys:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <conv:BoolToGridLengthConverter x:Key="BoolToGridLengthConverter" />

        <!-- StockFront palette (see CLAUDE.md): one orange accent on a warm neutral background. -->
        <Color x:Key="AccentColor">#E0632B</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#C9551F" />
        <SolidColorBrush x:Key="WorkAreaBrush" Color="#F2F0EB" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ActiveNavBrush" Color="#FBEDE4" />
        <SolidColorBrush x:Key="HeadingBrush" Color="#2B2B2B" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8A8A8A" />
        <SolidColorBrush x:Key="DividerBrush" Color="#EDEAE4" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#D24B4B" />

        <!-- Map page ViewModels to their views, so the shell's ContentControl renders the right page. -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WarehouseViewModel}">
            <views:WarehouseView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorefrontViewModel}">
            <views:StorefrontView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrdersViewModel}">
            <views:OrdersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
    </Application.Resources>
</Application>
