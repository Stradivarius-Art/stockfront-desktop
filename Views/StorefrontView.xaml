<UserControl x:Class="stockfront.Views.StorefrontView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:stockfront.ViewModels"
             xmlns:behaviors="clr-namespace:stockfront.Behaviors"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StorefrontViewModel}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <!-- Orange filled action button -->
        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Padding="22,0"
                                Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline (secondary) button -->
        <Style x:Key="SecondaryButton"
               TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="12" Padding="22,0"
                                Background="White"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource WorkAreaBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,12,0,5"/>
        </Style>

        <!-- Rounded text input -->
        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small round +/- stepper button -->
        <Style x:Key="StepperButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{StaticResource WorkAreaBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource ActiveNavBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded dropdown item — matches the rest of the rounded UI -->
        <Style x:Key="RoundedComboItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="8" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WorkAreaBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ActiveNavBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Availability badge (shared by card and list rows) -->
        <DataTemplate x:Key="AvailabilityBadge">
            <TextBlock FontSize="12"
                       Text="{Binding Availability, Converter={StaticResource StorefrontAvailabilityConverter}, ConverterParameter=Label}"
                       Foreground="{Binding Availability, Converter={StaticResource StorefrontAvailabilityConverter}, ConverterParameter=Foreground}"/>
        </DataTemplate>

        <!-- ── Catalog card (grid view) ──────────────────────────────────── -->
        <!-- No fixed Width: the card stretches to fill its (equal-width) UniformGrid cell, so a row of
             cards spans the full width instead of leaving a gap on the right. -->
        <DataTemplate x:Key="CatalogCardTemplate">
            <Border Background="{StaticResource CardBrush}" CornerRadius="16"
                    HorizontalAlignment="Stretch" Margin="8,0,8,16" Padding="16">
                <StackPanel>
                    <!-- Image (or placeholder) + admin edit -->
                    <Grid Height="120">
                        <Border CornerRadius="12" Background="{StaticResource WorkAreaBrush}"/>
                        <iconPacks:PackIconMaterial Kind="ImageArea" Width="34" Height="34"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border CornerRadius="12">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding ImagePath, Converter={StaticResource ImageSourceConverter}}"/>
                            </Border.Background>
                        </Border>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                                Cursor="Hand" ToolTip="Картинка и описание"
                                Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}"
                                Visibility="{Binding DataContext.CanEditCards, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="White" CornerRadius="8"
                                            Width="30" Height="30">
                                        <iconPacks:PackIconMaterial Kind="Pencil" Width="14" Height="14"
                                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource ActiveNavBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource HeadingBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,14,0,0"/>

                    <!-- Description (optional) -->
                    <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,4,0,0" Height="32"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Description, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <!-- Price + availability -->
                    <Grid Margin="0,8,0,12">
                        <TextBlock Text="{Binding Price, Converter={StaticResource MoneyToRubleConverter}}"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <ContentControl HorizontalAlignment="Right" VerticalAlignment="Center"
                                        ContentTemplate="{StaticResource AvailabilityBadge}" Content="{Binding}"/>
                    </Grid>

                    <!-- Add-to-cart / out-of-stock -->
                    <Grid>
                        <Button Content="В корзину"
                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Availability}" Value="OutOfStock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border CornerRadius="12" Height="42" Background="{StaticResource WorkAreaBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Availability}" Value="OutOfStock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Нет в наличии" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── Catalog row (list view, used when there are only a few products) ── -->
        <DataTemplate x:Key="CatalogListTemplate">
            <Border Background="{StaticResource CardBrush}" CornerRadius="14" Margin="0,0,0,12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Thumbnail -->
                    <Grid Grid.Column="0" Width="72" Height="72" VerticalAlignment="Center">
                        <Border CornerRadius="10" Background="{StaticResource WorkAreaBrush}"/>
                        <iconPacks:PackIconMaterial Kind="ImageArea" Width="22" Height="22"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border CornerRadius="10">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill"
                                            ImageSource="{Binding ImagePath, Converter={StaticResource ImageSourceConverter}}"/>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- Name + description -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource HeadingBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0" MaxHeight="34"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding Description, Converter={StaticResource NullToCollapsedConverter}}"/>
                        <ContentControl ContentTemplate="{StaticResource AvailabilityBadge}" Content="{Binding}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,18,0"
                               Text="{Binding Price, Converter={StaticResource MoneyToRubleConverter}}"
                               FontSize="17" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>

                    <!-- Add-to-cart / out-of-stock -->
                    <Grid Grid.Column="3" VerticalAlignment="Center" MinWidth="150">
                        <Button Content="В корзину"
                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Availability}" Value="OutOfStock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Border CornerRadius="12" Height="42" Background="{StaticResource WorkAreaBrush}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Availability}" Value="OutOfStock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="Нет в наличии" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Button Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center"
                            Cursor="Hand" ToolTip="Картинка и описание"
                            Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding DataContext.CanEditCards, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bg" Background="{StaticResource WorkAreaBrush}" CornerRadius="8"
                                        Width="36" Height="36">
                                    <iconPacks:PackIconMaterial Kind="Pencil" Width="15" Height="15"
                                                                Foreground="{StaticResource SecondaryTextBrush}"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{StaticResource ActiveNavBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Rounded category filter combo (closed control + popup), matches the warehouse look -->
        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource HeadingBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RoundedComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="18"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="1">
                                            <iconPacks:PackIconMaterial Kind="ChevronDown" Width="14" Height="14"
                                                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                        Margin="0,0,14,0"
                                                                        Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="14,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border CornerRadius="10" Background="White" Margin="0,4,0,6"
                                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#33000000" BlurRadius="14" ShadowDepth="2" Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Margin="0,4"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root: content + modal overlays on top -->
    <Grid>
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Heading + cart -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Витрина" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource HeadingBrush}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource PrimaryButton}" MinWidth="150"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding OpenCartCommand}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="CartOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CartCount, StringFormat='Корзина · {0}'}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Category filter — a single rounded dropdown that scales to any number of categories -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                <TextBlock Text="Категория" VerticalAlignment="Center" Margin="0,0,10,0"
                           FontSize="13" Foreground="{StaticResource SecondaryTextBrush}"/>
                <ComboBox Style="{StaticResource FilterCombo}" Width="240"
                          ItemsSource="{Binding Filters}"
                          SelectedItem="{Binding ActiveFilter, Mode=TwoWay}"/>
            </StackPanel>

            <!-- Catalog: a grid of cards normally, a list when there are only a few products -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <ItemsControl ItemsSource="{Binding Products}"
                                  ItemTemplate="{StaticResource CatalogCardTemplate}"
                                  Visibility="{Binding IsGridView, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Columns reflow to fill the width: as many ~268px cells as fit, cards
                                     stretch to share the row evenly (see behaviors:ResponsiveColumns). -->
                                <UniformGrid behaviors:ResponsiveColumns.ItemMinWidth="268"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Products}"
                                  ItemTemplate="{StaticResource CatalogListTemplate}"
                                  Visibility="{Binding IsListView, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </ScrollViewer>

            <TextBlock Grid.Row="2" Text="{Binding Error}"
                       Foreground="{StaticResource ErrorBrush}"
                       VerticalAlignment="Bottom" Margin="4"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsedConverter}}"/>
        </Grid>

        <!-- ── Cart overlay ──────────────────────────────────────────────── -->
        <Border Background="#55000000"
                Visibility="{Binding IsCartOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="16" Padding="28" Width="540" MaxHeight="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Корзина" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource HeadingBrush}"/>

                    <!-- Empty state -->
                    <TextBlock Grid.Row="1" Text="Корзина пуста" Margin="0,24"
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                                  Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Cart}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource HeadingBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding UnitPrice, Converter={StaticResource MoneyToRubleConverter}}"
                                                           FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Quantity stepper -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                <Button Style="{StaticResource StepperButton}" Content="−"
                                                        Command="{Binding DataContext.DecrementLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <TextBlock Text="{Binding Quantity}" MinWidth="28" FontSize="14"
                                                           TextAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{StaticResource HeadingBrush}"/>
                                                <Button Style="{StaticResource StepperButton}" Content="+"
                                                        Command="{Binding DataContext.IncrementLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"
                                                       Text="{Binding LineTotal, Converter={StaticResource MoneyToRubleConverter}}"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{StaticResource HeadingBrush}"/>

                                            <Button Grid.Column="3" Cursor="Hand" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    ToolTip="Убрать"
                                                    Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" Width="28" Height="28" CornerRadius="8" Background="Transparent">
                                                            <iconPacks:PackIconMaterial Kind="Close" Width="13" Height="13"
                                                                                        Foreground="{StaticResource SecondaryTextBrush}"
                                                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource WorkAreaBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Total -->
                    <Grid Grid.Row="2" Margin="0,16,0,0"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Итого" FontSize="15" Foreground="{StaticResource SecondaryTextBrush}"
                                   VerticalAlignment="Center"/>
                        <TextBlock HorizontalAlignment="Right" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="{Binding CartTotal, Converter={StaticResource MoneyToRubleConverter}}"/>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{Binding CheckoutError}"
                               Foreground="{StaticResource ErrorBrush}" FontSize="13" Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding CheckoutError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Продолжить покупки" Style="{StaticResource SecondaryButton}"
                                MinWidth="180" Command="{Binding CloseCartCommand}" Margin="0,0,12,0"/>
                        <Button Content="Оформить заказ" Style="{StaticResource PrimaryButton}"
                                MinWidth="160" Command="{Binding CheckoutCommand}"
                                IsEnabled="{Binding HasItems}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- ── Order confirmation overlay ────────────────────────────────── -->
        <Border Background="#55000000"
                Visibility="{Binding IsConfirmationOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="16" Padding="32" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="{StaticResource ActiveNavBrush}" Width="64" Height="64" CornerRadius="32">
                        <iconPacks:PackIconMaterial Kind="CheckBold" Width="28" Height="28"
                                                    Foreground="{StaticResource AccentBrush}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{Binding ConfirmationText}" Margin="0,18,0,0" FontSize="15"
                               Foreground="{StaticResource HeadingBrush}" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="320"/>
                    <Button Content="Отлично" Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="0,22,0,0"
                            Command="{Binding CloseConfirmationCommand}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- ── Admin card editor overlay ─────────────────────────────────── -->
        <Border Background="#55000000"
                Visibility="{Binding IsEditOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="16" Padding="28" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Картинка и описание" FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource HeadingBrush}"/>
                    <TextBlock Text="{Binding EditProductName}" FontSize="13" Margin="0,4,0,0"
                               Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Text="Изображение" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <!-- Preview / placeholder -->
                        <Grid Width="96" Height="96">
                            <Border CornerRadius="12" Background="{StaticResource WorkAreaBrush}"/>
                            <iconPacks:PackIconMaterial Kind="ImageArea" Width="26" Height="26"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Border CornerRadius="12">
                                <Border.Background>
                                    <ImageBrush Stretch="UniformToFill"
                                                ImageSource="{Binding EditImagePath, Converter={StaticResource ImageSourceConverter}}"/>
                                </Border.Background>
                            </Border>
                        </Grid>

                        <StackPanel VerticalAlignment="Center" Margin="14,0,0,0">
                            <Button Content="Выбрать файл" Style="{StaticResource SecondaryButton}"
                                    MinWidth="150" Command="{Binding PickImageCommand}"/>
                            <Button Content="Удалить" Style="{StaticResource SecondaryButton}"
                                    MinWidth="150" Margin="0,8,0,0" Command="{Binding ClearImageCommand}"
                                    Visibility="{Binding HasEditImage, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}" Height="92"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{Binding EditError}" Foreground="{StaticResource ErrorBrush}"
                               FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"
                               Visibility="{Binding EditError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" MinWidth="110"
                                Command="{Binding CancelEditCommand}" Margin="0,0,12,0"/>
                        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" MinWidth="130"
                                Command="{Binding SubmitEditCommand}"
                                IsEnabled="{Binding EditBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ── "Added to cart" toast ─────────────────────────────────────── -->
        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,28"
                Background="{StaticResource HeadingBrush}" CornerRadius="12" Padding="20,12"
                IsHitTestVisible="False"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect Color="#33000000" BlurRadius="16" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <iconPacks:PackIconMaterial Kind="CheckBold" Width="16" Height="16"
                                            Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ToastText}" Foreground="White" FontSize="14" FontWeight="SemiBold"
                           Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>