<UserControl x:Class="stockfront.Views.WarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:stockfront.ViewModels"
             xmlns:behaviors="clr-namespace:stockfront.Behaviors"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:WarehouseViewModel}"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <Style x:Key="ColHeader"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="13"/>
        </Style>
        <Style x:Key="Cell"
               TargetType="TextBlock">
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="VerticalAlignment"
                    Value="Center"/>
            <Setter Property="Foreground"
                    Value="{StaticResource HeadingBrush}"/>
        </Style>

        <!-- Orange filled action button -->
        <Style x:Key="PrimaryButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Padding="22,0"
                                Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bg"
                                        Property="Background"
                                        Value="{StaticResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Bg"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outline (secondary) button -->
        <Style x:Key="SecondaryButton"
               TargetType="Button">
            <Setter Property="Height"
                    Value="44"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Foreground"
                    Value="{StaticResource HeadingBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="12"
                                Padding="22,0"
                                Background="White"
                                BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="Bg"
                                        Property="Background"
                                        Value="{StaticResource WorkAreaBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="Bg"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form field label -->
        <Style x:Key="FieldLabel"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="FontSize"
                    Value="13"/>
            <Setter Property="Margin"
                    Value="0,12,0,5"/>
        </Style>

        <!-- Rounded text input -->
        <Style x:Key="InputBox"
               TargetType="TextBox">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="Padding"
                    Value="10,0"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item templates: also used for the closed selection box, so the name/label renders
             instead of the object's ToString() under the custom ComboBox template. -->
        <DataTemplate x:Key="ComboItemName">
            <TextBlock Text="{Binding Name}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <DataTemplate x:Key="ComboItemLabel">
            <TextBlock Text="{Binding Label}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DataTemplate>

        <!-- Rounded dropdown item — matches the rest of the rounded UI -->
        <Style x:Key="RoundedComboItem"
               TargetType="ComboBoxItem">
            <Setter Property="Padding"
                    Value="12,8"/>
            <Setter Property="Margin"
                    Value="4,2"/>
            <Setter Property="Foreground"
                    Value="{StaticResource HeadingBrush}"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="SnapsToDevicePixels"
                    Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                CornerRadius="8"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource WorkAreaBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="Bd"
                                        Property="Background"
                                        Value="{StaticResource ActiveNavBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded combo box (closed control + popup), to match InputBox -->
        <Style x:Key="InputCombo"
               TargetType="ComboBox">
            <Setter Property="Height"
                    Value="38"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="Foreground"
                    Value="{StaticResource HeadingBrush}"/>
            <Setter Property="Background"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Padding"
                    Value="12,0"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource RoundedComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                CornerRadius="10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="1">
                                            <iconPacks:PackIconMaterial Kind="ChevronDown"
                                                                        Width="14"
                                                                        Height="14"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,12,0"
                                                                        Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,34,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border CornerRadius="10"
                                        Background="White"
                                        Margin="0,4,0,6"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#33000000"
                                                          BlurRadius="14"
                                                          ShadowDepth="2"
                                                          Direction="270"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter Margin="0,4"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Searchable combo: same look as InputCombo, but the popup gets a type-to-filter search box
             at the top (PART_SearchBox, driven by behaviors:ComboBoxSearch). Use for long lists. -->
        <Style x:Key="SearchableCombo"
               TargetType="ComboBox"
               BasedOn="{StaticResource InputCombo}">
            <!-- Search box owns the keyboard; disable the built-in type-ahead so it doesn't compete. -->
            <Setter Property="IsTextSearchEnabled"
                    Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd"
                                                CornerRadius="10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="1">
                                            <iconPacks:PackIconMaterial Kind="ChevronDown"
                                                                        Width="14"
                                                                        Height="14"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,12,0"
                                                                        Foreground="{StaticResource SecondaryTextBrush}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked"
                                                     Value="True">
                                                <Setter TargetName="Bd"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,34,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Slide">
                                <Border CornerRadius="10"
                                        Background="White"
                                        Margin="0,4,0,6"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="1"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#33000000"
                                                          BlurRadius="14"
                                                          ShadowDepth="2"
                                                          Direction="270"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Type-to-filter search box -->
                                        <Border Grid.Row="0"
                                                Margin="8,8,8,4"
                                                Height="34"
                                                CornerRadius="8"
                                                Background="{StaticResource WorkAreaBrush}">
                                            <Grid Margin="10,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconMaterial Grid.Column="0"
                                                                            Kind="Magnify"
                                                                            Width="14"
                                                                            Height="14"
                                                                            Foreground="{StaticResource SecondaryTextBrush}"
                                                                            VerticalAlignment="Center"/>
                                                <Grid Grid.Column="1"
                                                      Margin="8,0,0,0">
                                                    <TextBlock Text="Поиск…"
                                                               FontSize="13"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"
                                                               Foreground="{StaticResource SecondaryTextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=PART_SearchBox}"
                                                                                 Value="">
                                                                        <Setter Property="Visibility"
                                                                                Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox x:Name="PART_SearchBox"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             FontSize="13"
                                                             VerticalContentAlignment="Center"
                                                             Foreground="{StaticResource HeadingBrush}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <ScrollViewer Grid.Row="1"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter Margin="0,4"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Root: content + modal overlays on top -->
    <Grid>
        <Grid Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Heading + actions -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Склад"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource HeadingBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="Журнал операций"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="160"
                            Command="{Binding OpenJournalCommand}"
                            Margin="0,0,12,0"/>
                    <Button Content="Списание"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="130"
                            Command="{Binding OpenWriteOffCommand}"
                            Margin="0,0,12,0"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            MinWidth="150"
                            Command="{Binding OpenReceiveCommand}">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Kind="Plus"
                                                        Width="16"
                                                        Height="16"
                                                        VerticalAlignment="Center"/>
                            <TextBlock Text="Приёмка"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filters + search -->
            <Grid Grid.Row="1"
                  Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Status dropdown — the Days-of-Supply buckets, formerly a row of chips -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left">
                    <TextBlock Text="Статус"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ComboBox Style="{StaticResource InputCombo}"
                              Width="180"
                              ItemsSource="{Binding Filters}"
                              SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"/>
                </StackPanel>

                <!-- Category dropdown — scales to any number of categories without overflowing the row -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0">
                    <TextBlock Text="Категория"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"
                               FontSize="13"
                               Foreground="{StaticResource SecondaryTextBrush}"/>
                    <ComboBox Style="{StaticResource InputCombo}"
                              Width="200"
                              ItemsSource="{Binding CategoryFilters}"
                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}"/>
                </StackPanel>

                <Border Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="White"
                        CornerRadius="18"
                        Width="240"
                        Height="38"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="1">
                    <Grid Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Grid.Column="0"
                                                    Kind="Magnify"
                                                    Width="15"
                                                    Height="15"
                                                    Foreground="{StaticResource SecondaryTextBrush}"
                                                    VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,0"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Products table -->
            <Border Grid.Row="2"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="16"
                    Padding="24,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"
                                              MinWidth="120"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="88"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Товар"
                                   Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="1"
                                   Text="Артикул"
                                   Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="2"
                                   Text="Категория"
                                   Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="3"
                                   Text="Остаток"
                                   Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="4"
                                   Text="Цена"
                                   Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="5"
                                   Text="Статус"
                                   Style="{StaticResource ColHeader}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Products}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,14">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"
                                                                  MinWidth="120"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="88"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Name}"
                                                       Style="{StaticResource Cell}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Sku}"
                                                       Style="{StaticResource Cell}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Category}"
                                                       Style="{StaticResource Cell}"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Quantity}"
                                                       Style="{StaticResource Cell}"/>
                                            <TextBlock Grid.Column="4"
                                                       Style="{StaticResource Cell}"
                                                       Text="{Binding Price, Converter={StaticResource MoneyToRubleConverter}}"/>

                                            <Border Grid.Column="5"
                                                    CornerRadius="10"
                                                    Padding="10,3"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding Status, Converter={StaticResource StockStatusConverter}, ConverterParameter=Background}">
                                                <Border.ToolTip>
                                                    <ToolTip Content="{Binding DaysOfSupply, Converter={StaticResource DaysOfSupplyTooltipConverter}}"/>
                                                </Border.ToolTip>
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Status, Converter={StaticResource StockStatusConverter}, ConverterParameter=Label}"
                                                           Foreground="{Binding Status, Converter={StaticResource StockStatusConverter}, ConverterParameter=Foreground}"/>
                                            </Border>

                                            <!-- Row actions (admin only): edit always; delete only when stock is 0 -->
                                            <StackPanel Grid.Column="6"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding DataContext.CanEditProducts, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button Cursor="Hand"
                                                        ToolTip="Редактировать товар"
                                                        Command="{Binding DataContext.OpenEditProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg"
                                                                    Width="32"
                                                                    Height="32"
                                                                    CornerRadius="8"
                                                                    Background="{StaticResource WorkAreaBrush}">
                                                                <iconPacks:PackIconMaterial Kind="Pencil"
                                                                                            Width="14"
                                                                                            Height="14"
                                                                                            Foreground="{StaticResource SecondaryTextBrush}"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="{StaticResource ActiveNavBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>

                                                <!-- Delete — shown only for an empty (0 stock) product -->
                                                <Button Cursor="Hand"
                                                        Margin="8,0,0,0"
                                                        ToolTip="Удалить товар"
                                                        Command="{Binding DataContext.RequestDeleteProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding Quantity, Converter={StaticResource ZeroToVisibleConverter}}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Bg"
                                                                    Width="32"
                                                                    Height="32"
                                                                    CornerRadius="8"
                                                                    Background="{StaticResource WorkAreaBrush}">
                                                                <iconPacks:PackIconMaterial Kind="TrashCanOutline"
                                                                                            Width="15"
                                                                                            Height="15"
                                                                                            Foreground="{StaticResource SecondaryTextBrush}"
                                                                                            HorizontalAlignment="Center"
                                                                                            VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bg" Property="Background" Value="#F8D7D7"/>
                                                                    <Setter TargetName="Bg" Property="Opacity" Value="1"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Grid.Row="2"
                       Text="{Binding Error}"
                       Foreground="{StaticResource ErrorBrush}"
                       VerticalAlignment="Bottom"
                       Margin="4"
                       Visibility="{Binding Error, Converter={StaticResource NullToCollapsedConverter}}"/>
        </Grid>

        <!-- ── Receive overlay ───────────────────────────────────────────── -->
        <Border Background="#55000000"
                Visibility="{Binding IsReceiveOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="28"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Приёмка товара"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource HeadingBrush}"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,16,0,0">
                        <RadioButton Content="Существующий"
                                     GroupName="receiveMode"
                                     Margin="0,0,20,0"
                                     Foreground="{StaticResource HeadingBrush}"
                                     IsChecked="{Binding ReceiveIsNewProduct, Converter={StaticResource InverseBooleanConverter}}"/>
                        <RadioButton Content="Новый товар"
                                     GroupName="receiveMode"
                                     Foreground="{StaticResource HeadingBrush}"
                                     IsChecked="{Binding ReceiveIsNewProduct}"/>
                    </StackPanel>

                    <!-- Existing product -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReceiveIsNewProduct}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Товар"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource SearchableCombo}"
                                  behaviors:ComboBoxSearch.Enabled="True"
                                  ItemsSource="{Binding AllProducts}"
                                  ItemTemplate="{StaticResource ComboItemName}"
                                  SelectedItem="{Binding ReceiveSelectedProduct}"/>
                    </StackPanel>

                    <!-- New product -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility"
                                        Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ReceiveIsNewProduct}"
                                                 Value="True">
                                        <Setter Property="Visibility"
                                                Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Артикул"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding ReceiveNewSku, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Название"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding ReceiveNewName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Категория"
                                   Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource InputCombo}"
                                  ItemsSource="{Binding Categories}"
                                  ItemTemplate="{StaticResource ComboItemName}"
                                  SelectedItem="{Binding ReceiveSelectedCategory}"/>
                        <TextBlock Text="Цена, ₽"
                                   Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource InputBox}"
                                 Text="{Binding ReceiveNewPrice, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <TextBlock Text="Количество"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding ReceiveQuantity, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="{Binding ReceiveError}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding ReceiveError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Отмена"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="110"
                                Command="{Binding CancelReceiveCommand}"
                                Margin="0,0,12,0"/>
                        <Button Content="Принять"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="130"
                                Command="{Binding SubmitReceiveCommand}"
                                IsEnabled="{Binding ReceiveBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ── Write-off overlay ─────────────────────────────────────────── -->
        <Border Background="#55000000"
                Visibility="{Binding IsWriteOffOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="28"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Списание товара"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource HeadingBrush}"/>

                    <TextBlock Text="Товар"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource SearchableCombo}"
                              behaviors:ComboBoxSearch.Enabled="True"
                              ItemsSource="{Binding AllProducts}"
                              ItemTemplate="{StaticResource ComboItemName}"
                              SelectedItem="{Binding WriteOffSelectedProduct}"/>

                    <TextBlock Text="Количество"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding WriteOffQuantity, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Причина"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource InputCombo}"
                              ItemsSource="{Binding WriteOffReasons}"
                              ItemTemplate="{StaticResource ComboItemLabel}"
                              SelectedItem="{Binding WriteOffSelectedReason}"/>

                    <TextBlock Text="{Binding WriteOffError}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding WriteOffError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Отмена"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="110"
                                Command="{Binding CancelWriteOffCommand}"
                                Margin="0,0,12,0"/>
                        <Button Content="Списать"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="130"
                                Command="{Binding SubmitWriteOffCommand}"
                                IsEnabled="{Binding WriteOffBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ── Edit product overlay (name / price / category) ──────────────── -->
        <Border Background="#55000000"
                Visibility="{Binding IsEditProductOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="28"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Редактирование товара"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource HeadingBrush}"/>

                    <TextBlock Text="Название"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding EditProductName, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Цена, ₽"
                               Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource InputBox}"
                             Text="{Binding EditProductPrice, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Категория"
                               Style="{StaticResource FieldLabel}"/>
                    <ComboBox Style="{StaticResource InputCombo}"
                              ItemsSource="{Binding Categories}"
                              ItemTemplate="{StaticResource ComboItemName}"
                              SelectedItem="{Binding EditProductCategory}"/>

                    <TextBlock Text="{Binding EditProductError}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding EditProductError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Отмена"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="110"
                                Command="{Binding CancelEditProductCommand}"
                                Margin="0,0,12,0"/>
                        <Button Content="Сохранить"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="130"
                                Command="{Binding SubmitEditProductCommand}"
                                IsEnabled="{Binding EditProductBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ── Delete product confirmation ─────────────────────────────────── -->
        <Border Background="#55000000"
                Visibility="{Binding IsDeleteConfirmOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="28"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Удалить товар?"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource HeadingBrush}"/>
                    <TextBlock Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               FontSize="14"
                               Foreground="{StaticResource SecondaryTextBrush}">
                        <Run Text="«"/><Run Text="{Binding DeleteTarget.Name}"/><Run Text="» будет удалён вместе с историей операций. Действие необратимо."/>
                    </TextBlock>

                    <TextBlock Text="{Binding DeleteError}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding DeleteError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Отмена"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="110"
                                Command="{Binding CancelDeleteProductCommand}"
                                Margin="0,0,12,0"/>
                        <Button Content="Удалить"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="130"
                                Command="{Binding ConfirmDeleteProductCommand}"
                                IsEnabled="{Binding DeleteBusy, Converter={StaticResource InverseBooleanConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ── Operations journal overlay (history + rollback) ───────────────── -->
        <Border Background="#55000000"
                Visibility="{Binding IsJournalOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="16"
                    Padding="28"
                    Width="760"
                    MaxHeight="560"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Журнал операций"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource HeadingBrush}"/>

                    <!-- Column headers -->
                    <Grid Grid.Row="1"
                          Margin="0,18,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Дата" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="1" Text="Товар / комментарий" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="2" Text="Операция" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="3" Text="Кол-во" Style="{StaticResource ColHeader}"/>
                        <TextBlock Grid.Column="4" Text="" Style="{StaticResource ColHeader}"/>
                    </Grid>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Movements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding CreatedAt, StringFormat='dd.MM.yy HH:mm'}"
                                                       Style="{StaticResource Cell}"
                                                       FontSize="13"
                                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}"
                                                           Style="{StaticResource Cell}"/>
                                                <TextBlock Text="{Binding Comment}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Visibility="{Binding Comment, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                <TextBlock Text="{Binding Reason}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource SecondaryTextBrush}"
                                                           Visibility="{Binding Reason, Converter={StaticResource NullToCollapsedConverter}}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TypeLabel}"
                                                       Style="{StaticResource Cell}"
                                                       FontSize="13"/>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding Quantity}"
                                                       Style="{StaticResource Cell}"
                                                       FontWeight="SemiBold"/>

                                            <Button Grid.Column="4"
                                                    Content="Откат"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Height="34"
                                                    Command="{Binding DataContext.RevertMovementCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding CanRevert, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="3"
                               Text="{Binding JournalError}"
                               Foreground="{StaticResource ErrorBrush}"
                               FontSize="13"
                               Margin="0,12,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding JournalError, Converter={StaticResource NullToCollapsedConverter}}"/>

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,20,0,0">
                        <Button Content="Закрыть"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="120"
                                Command="{Binding CloseJournalCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>